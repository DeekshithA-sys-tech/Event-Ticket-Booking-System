# ═══════════════════════════════════════════════════════════════
# Event Ticket Booking System — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in every value before running the server
#   3. NEVER commit .env to Git — it's in .gitignore
#   4. The server will refuse to start if required vars are missing
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── MongoDB Atlas ────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Clusters → Connect
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/event-ticket-booking

# ── JWT ──────────────────────────────────────────────────────────
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use DIFFERENT secrets for access and refresh tokens
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Redis ────────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Cloud (Upstash, Railway): rediss://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# ── Cloudinary ───────────────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email (Nodemailer) ───────────────────────────────────────────
# Development: Use Mailtrap https://mailtrap.io (free fake SMTP)
# Production: Use SendGrid, Mailgun, or AWS SES
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
EMAIL_FROM="Event Ticket Booking <no-reply@eventbooking.com>"

# ── Rate Limiting ────────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS: Time window in milliseconds (900000 = 15 minutes)
# RATE_LIMIT_MAX: Max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
